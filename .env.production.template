# Rihla Frontend - Production Environment Variables
# Copy this to .env.production and fill in your values
# DO NOT commit actual secrets to version control

# =============================================================================
# CORE API CONFIGURATION
# =============================================================================
# Core-Server is the single gateway. All calls go through /api
# For Vercel deployment, this should be your Vercel app URL + /api
NEXT_PUBLIC_API_BASE_URL=https://your-app.vercel.app/api

# =============================================================================
# OPTIONAL: External Service URLs (if needed by frontend directly)
# =============================================================================
# These are typically proxied through Core-Server, but kept for reference
# NEXT_PUBLIC_GEO_API_URL=https://your-app.vercel.app/api
# NEXT_PUBLIC_AI_API_URL=https://your-app.vercel.app/api
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# =============================================================================
# FEATURE FLAGS (optional)
# =============================================================================
# NEXT_PUBLIC_ENABLE_PWA=true
# NEXT_PUBLIC_ENABLE_ANALYTICS=true

# =============================================================================
# NOTES
# =============================================================================
# - Core-Server handles auth cookies (refreshToken at Path=/api/auth)
# - Vercel rewrite proxy in vercel.json forwards /api/* to Core-Server
# - All backend services (GIS, AI, Risk) are internal to Core-Server
# - Paymob webhook URL must be configured in Paymob dashboard
# - For local development, use .env.local with localhost values